                    local eh = far:FindFirstChild("HumanoidRootPart")
                    if eh then
                        h.CFrame = CFrame.new(eh.Position + Vector3.new(0, 20, 0), eh.Position)
                        h.Velocity = Vector3.new(0, 0, 0)
                    end
