local function Equip()
    pcall(function()
        local c = LP.Character
        if not c then return end
        for _, t in pairs(c:GetChildren()) do
            if t:IsA("Tool") then return end
        end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in pairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local h = Hum()
                if h then h:EquipTool(t) end
                return
            end
        end
    end)
end

local AC = nil
spawn(function()
    pcall(function()
        local ok, cf = pcall(function()
            return require(LP.PlayerScripts:WaitForChild("CombatFramework", 3))
        end)
        if ok then AC = cf end
    end)
