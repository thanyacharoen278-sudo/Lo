local function StopShake()
    pcall(function()
        local u = RS:FindFirstChild("Util")
        if u and u:FindFirstChild("CameraShaker") then
            local Cam = require(u.CameraShaker)
            if Cam and Cam.Stop then Cam:Stop() end
        end
    end)
end

local function DoAttack()
    StopShake()
    pcall(function()
        if AC and AC.activeController then
            local c = AC.activeController
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = _G.HitboxSize or 90
            c.increment = 4
            if c.focusStart then c.focusStart = 0 end
        end
    end)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
    end)
    task.wait(0.025)
    pcall(function()
        VU:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        local x, y = 500, 300
        if cam then
            x = cam.ViewportSize.X / 2
            y = cam.ViewportSize.Y / 2
        end
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    pcall(function()
        local c = LP.Character
        if c then
            local t = c:FindFirstChildOfClass("Tool")
            if t then t:Activate() end
        end
    end)
end

local function GetEnemy(maxDist)
    local h = HRP()
    if not h then return nil end
    local near, best = nil, maxDist or 8000
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d < best then
                near = m
                best = d
            end
        end
    end
    return near
end

local function GetFarEnemy(minDist)
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, math.huge
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    minDist = minDist or 80
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d > minDist and d < bestD then
                best = m
                bestD = d
            end
        end
    end
    return best
end

local function BringMobs(pos)
    pcall(function()
        local folder = workspace:FindFirstChild("Enemies")
        if not folder then return end
        for _, m in pairs(folder:GetChildren()) do
            local mh = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 then
                local d = (mh.Position - pos).Magnitude
                if d < 250 and d > 5 then
                    mh.CFrame = CFrame.new(pos + Vector3.new(math.random(-2, 2), 0, math.random(-2, 2)))
                    mh.CanCollide = false
                    mh.Velocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

