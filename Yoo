                        for _, isl in pairs(map:GetChildren()) do
                            local part = isl:FindFirstChildWhichIsA("BasePart", true)
                            if part and (h.Position - part.Position).Magnitude > 100 then
                                h.CFrame = part.CFrame + Vector3.new(0, 25, 0)
                                break
                            end
                        end
                    end
                end
            end)
